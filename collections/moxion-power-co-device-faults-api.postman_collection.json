          "id": "66956c02-6fb1-46f3-8b44-9e441e482e3c",
          "name": "Get Device Faults",
          "request": {
            "name": "Get Device Faults",
            "description": {
              "content": "Gets a set of Timestamped Faults for a device. The time range of Faults is specified with the start and end parameters, including start and excluding end - [start, end). The max duration cannot exceed 1 day.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "devices",
                ":deviceId",
                "faults"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) Inclusive start of the time range (ISO 8601). Range [start, end); max duration 1 day."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "(Required) Exclusive end of the time range (ISO 8601). Range [start, end); max duration 1 day."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "deviceId",
                  "description": "(Required) Identifier of the Mobile Power Unit device."
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "980c0b1e-b252-4bd9-8baa-797e249f2104",
              "name": "Timestamped faults for the device in the given range.",
