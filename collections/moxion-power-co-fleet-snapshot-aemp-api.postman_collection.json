          "name": "AEMP Fleet Snapshot",
          "request": {
            "name": "AEMP Fleet Snapshot",
            "description": {
              "content": "Get the AEMP 2.0 (ISO 15143-3 v.20190501) compliant Fleet Snapshot. Note that equipment is paged and returned in order of creation time. Snapshot timestamp is consistent within a single page but is not guaranteed across pages. Response type is JSON.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fleet",
                "snapshot"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
