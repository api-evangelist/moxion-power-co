          "id": "d9d8fc2e-f49f-4394-bacc-3b7f8b4bf57f",
          "name": "Get Device Metrics",
          "request": {
            "name": "Get Device Metrics",
            "description": {
              "content": "Gets a set of Timestamped Metrics for a device. The time range of metrics is specified with the start and end parameters, including start and excluding end - [start, end). The max duration cannot exceed 1 day.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "devices",
                ":deviceId",
                "metrics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) Inclusive start of the time range (ISO 8601). Range [start, end); max duration 1 day."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "(Required) Exclusive end of the time range (ISO 8601). Range [start, end); max duration 1 day."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "deviceId",
                  "description": "(Required) Identifier of the Mobile Power Unit device."
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
          "response": [
