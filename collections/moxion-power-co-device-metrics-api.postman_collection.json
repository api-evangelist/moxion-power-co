  "info": {
    "_postman_id": "fe7f21d6-61e6-4981-9abe-d7570300b382",
    "name": "Moxion Power Developer Device Faults Device Metrics API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API sharing resources and telemetry about an organization's Moxion Mobile Power Units (MPUs): device listing/details, GPS location, time-series device metrics, active fault codes, and AEMP 2.0 (ISO 15143-3 v.20190501) compliant fleet-snapshot endpoints.\n\nContact Support:\n Name: Moxion Power Support\n Email: help@moxionpower.com",
      "type": "text/plain"
    }
  }
