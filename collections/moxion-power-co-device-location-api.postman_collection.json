        {
          "id": "83f04fe4-53a1-414e-8486-79e833c3ff43",
          "name": "Get Device Locations",
          "request": {
            "name": "Get Device Locations",
            "description": {
              "content": "Gets a set of Timestamped Locations for a device. The time range of locations is specified with the start and end parameters, including start and excluding end - [start, end). The max duration cannot exceed 1 day.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "devices",
                ":deviceId",
                "locations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) Inclusive start of the time range (ISO 8601). Range [start, end); max duration 1 day."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "(Required) Exclusive end of the time range (ISO 8601). Range [start, end); max duration 1 day."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "deviceId",
                  "description": "(Required) Identifier of the Mobile Power Unit device."
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "d1bbf9e9-f017-416e-8ba7-97ab83f9e374",
              "name": "Timestamped locations for the device in the given range.",
              "originalRequest": {
